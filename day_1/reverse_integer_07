class Solution {
    public int reverse(int x) {
        int digit;
        int res=0;
        while(Math.abs(x)>0)
        {
            digit=x%10;
            if (res > Integer.MAX_VALUE / 10 || (res == Integer.MAX_VALUE / 10 && digit > 7))
            {
                return 0;
            }
            if (res < Integer.MIN_VALUE / 10 || (res == Integer.MIN_VALUE / 10 && digit < -8))
            {
                return 0;
            }
            res=res*10+digit;
            x=x/10;
        }
        if(x<0)
        {
            res=-res;
        }
    return res;
    }
}
